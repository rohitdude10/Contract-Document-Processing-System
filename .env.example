
APP_NAME=Contract Processing System
APP_ENV=development
DEBUG=true

HOST=127.0.0.1
PORT=8000

DATABASE_URL=postgresql+asyncpg://contract_user:contract_dev_password@localhost:5432/contract_db

RABBITMQ_URL=amqp://contract_user:contract_rabbit_password@localhost:5672/contract_processing

STORAGE_PATH=storage/uploads
TEMP_PATH=storage/temp

MAX_DOCUMENTS_PER_BATCH=1000
MAX_DOCUMENT_SIZE_MB=15

RABBITMQ_QUEUE=document_processing
RABBITMQ_DLQ=document_processing_dlq

WORKER_CONCURRENCY=5
MAX_RETRIES=3

MOCK_EXTRACTION_MIN_LATENCY_SECONDS=1.0
MOCK_EXTRACTION_MAX_LATENCY_SECONDS=3.0
MOCK_EXTRACTION_FAILURE_RATE=0.0
